root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
# end_of_line se deja sin fijar a propósito: el repo está en CRLF y forzar LF
# aquí reescribiría ficheros enteros al guardar. Normalizar (vía .gitattributes)
# es una decisión aparte que tocaría todo el árbol.

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
